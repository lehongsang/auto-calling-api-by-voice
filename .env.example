# Cấu hình kết nối tới VN Doctor Backend
VN_DOCTOR_API_BASE_URL=https://api-navi-doctor.tomotek.vn/api

# Cấu hình AI Provider (Chọn OPENAI hoặc GEMINI)
AI_PROVIDER=OPENAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Hoặc dùng Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Cấu hình Session Timeout (giây) - mặc định 300s = 5 phút
SESSION_TTL_SECONDS=300
